# Copy this file to .env and fill in your own values.
# Do NOT commit .env to git.

# --- Judge LLM used for Pass Rate evaluation (OpenAI-compatible) ---
# Any provider that speaks the OpenAI Chat Completions API works.
# Leave JUDGE_API_BASE empty to use the OpenAI default endpoint.
JUDGE_API_KEY=
JUDGE_API_BASE=
JUDGE_MODEL=

# --- HYSET assets ---
HYSET_CHECKPOINT_PATH=checkpoints/hyset/best.pt
HYSET_ENCODER_PATH=/path/to/Qwen2.5-1.5B-Tool-Retriever
HYSET_CORPUS_PATH=data/hyset_corpus.json
HYSET_DEVICE=cuda:0
